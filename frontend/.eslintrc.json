{
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["_id"] }],
    "import/no-unresolved": [
      "error",
      { "ignore": ["^vite$", "^@vitejs/plugin-react$"] }
    ],
    "import/prefer-default-export": "off"
  }
}
