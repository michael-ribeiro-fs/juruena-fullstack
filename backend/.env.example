PORT=3000
NODE_ENV=development

# MongoDB Atlas — 3 bancos separados no mesmo cluster M0:
# - juruena-dev  (npm run dev)
# - juruena-test (npm test)
# - juruena-prod (deploy no Render)
MONGO_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/juruena-dev
MONGO_URI_TEST=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/juruena-test

# Em produção (NODE_ENV=production), JWT_SECRET é OBRIGATÓRIO.
# Se ausente, o processo NÃO sobe (falha rápida).
JWT_SECRET=dev-secret
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_DIR=./logs