{
  "extends": ["airbnb-base"],
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "strict": ["error", "global"],
    "no-underscore-dangle": ["error", { "allow": ["_id"] }],
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^(next|_)", "ignoreRestSiblings": true }
    ],
    "no-console": "error"
  }
}
